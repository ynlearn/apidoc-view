# 构建上下文瘦身：依赖、产物、数据与本地杂项一律不进 build context
node_modules
**/node_modules

# 各包构建产物（容器内重新构建）
packages/*/dist

# 本地运行数据与密钥，绝不进镜像
data

# 本地开发/测试物料
tests
docs
examples
.workbuddy
.long-task-control

# 环境文件（.env.example 例外，仅作说明用途）
.env
.env.*
!.env.example

# git 与本文件自身
.git
.gitignore
Dockerfile
docker-compose*.yml
.dockerignore

# 日志与截图
*.log
*.png
