# 复制为 .env 后按需修改：cp .env.example .env
# 真实环境变量优先级高于本文件（loadEnvFile 不覆盖已有变量），
# 所以 docker/k8s 里用 -e / env 注入时，这里的值会被忽略。

# ---------- 服务 ----------
PORT=3000
HOST=0.0.0.0
# 数据库方言：sqlite（默认，零依赖）/ mysql / postgres（别名 pg、postgresql、mariadb）
# DB_TYPE=sqlite
# SQLite 数据库文件路径（仅 sqlite 模式），默认 <项目根>/data/app.db
# DB_PATH=./data/app.db

# ---------- 外部数据库（mysql/postgres 模式，需预先建库，表结构首次启动自动创建）----------
# 建库/建表脚本（DBA 预审或应用账号无 DDL 权限时手动执行）：
#   scripts/sql/schema.mysql.sql  ·  scripts/sql/schema.postgres.sql
#
# 方式一：MySQL 现成实例（三选一填法任选，连接串优先）
# DB_TYPE=mysql
# DB_URL=mysql://apidoc:changeme@rmt01:3306/apidoc_view
# 或拆开填：
# DB_HOST=rmt01
# DB_PORT=3306
# DB_USER=apidoc
# DB_PASSWORD=changeme
# DB_NAME=apidoc_view

# 方式二：PostgreSQL 现成实例
# DB_TYPE=postgres
# DB_URL=postgres://apidoc:changeme@rmt01:5432/apidoc_view

# 连接池大小（两种方式通用，sqlite 模式忽略）
# DB_POOL_SIZE=10

# ---------- 鉴权（重点看这段）----------
# 管理端登录账号，默认 admin
ADMIN_USERNAME=admin

# 管理端登录密码。留空 = 首次启动生成随机密码，打印在启动日志并写入 data/.admin-password。
# 生产环境必须显式设置；不要在公网使用弱口令。
ADMIN_PASSWORD=

# 浏览端访问口令。留空 = 浏览端完全开放（谁都能看文档）。
# 填写 = 打开浏览页需先输口令才能看。这就是"浏览端鉴权开关"。
VIEW_PASSWORD=

# token 签名密钥。留空 = 自动生成随机值并落盘 data/.auth-secret（重启不失效）。
# 多实例部署必须所有实例设置同一值，否则 A 实例发的 token B 实例不认。
AUTH_SECRET=

# 登录态有效期（小时）
SESSION_TTL_HOURS=12

# ---------- 代理与安全 ----------
# MAX_IMPORT_BYTES=5242880
# REQUEST_TIMEOUT_MS=30000
# SSRF_INTERNAL_ALLOWLIST=127.0.0.1,192.168.1.10
# ALLOWED_HOSTS=*.example.com

# ---------- 历史 ----------
# HISTORY_RETENTION=200
